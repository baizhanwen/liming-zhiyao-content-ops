# Configure the real value through Sites for hosted environments.
ANALYZER_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Python analyzer worker. Keep secrets in the worker environment, not the browser site.
ANALYZER_BASE_URL=https://replace-with-private-site.example
ANALYZER_WORKER_ID=analyzer-01
ANALYZER_LLM_API_KEY=replace-with-provider-key
ANALYZER_LLM_BASE_URL=https://replace-with-openai-compatible-endpoint/v1
ANALYZER_LLM_MODEL=replace-with-model-name
ANALYZER_LLM_PROVIDER=deepseek-or-glm
ANALYZER_ASR_MODEL=paraformer-zh
ANALYZER_ASR_DEVICE=cpu
ANALYZER_PADDLE_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
ANALYZER_PADDLE_OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
ANALYZER_MODEL_CACHE=/replace-with-persistent-volume/model-cache

# OpenAI-compatible content generation provider (DeepSeek, GLM, OpenAI, etc.).
CONTENT_MODEL_PROVIDER=deepseek
CONTENT_MODEL_BASE_URL=https://api.deepseek.com/v1
CONTENT_MODEL_NAME=replace-with-model-name
CONTENT_MODEL_API_KEY=replace-with-provider-key
