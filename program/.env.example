# Hosted-environment reference. For local development, copy `.dev.vars.example`
# to `.dev.vars`; never commit real credentials.
ANALYZER_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Python analyzer worker. Keep secrets in the worker environment, not the browser site.
ANALYZER_BASE_URL=http://127.0.0.1:3000
ANALYZER_WORKER_ID=analyzer-01
ANALYZER_LLM_API_KEY=replace-with-provider-key
ANALYZER_LLM_BASE_URL=https://replace-with-openai-compatible-endpoint/v1
ANALYZER_LLM_MODEL=replace-with-model-name
ANALYZER_LLM_PROVIDER=deepseek-or-glm

# MiniMax Token Plan MCP visual understanding. The Key begins with sk-cp.
ANALYZER_VISION_PROVIDER=minimax-token-plan
ANALYZER_VISION_BASE_URL=https://api.minimaxi.com
ANALYZER_VISION_MODEL=understand_image
ANALYZER_VISION_API_KEY=replace-with-token-plan-key
ANALYZER_VISION_CONCURRENCY=2
# Windows x64 中文默认用 Qwen3-ASR-1.7B 转写，以下兼容设置选择 Whisper 时间定位模型。
ANALYZER_ASR_ENGINE=faster-whisper
ANALYZER_ASR_MODEL=large-v3-turbo
ANALYZER_ASR_DEVICE=auto
ANALYZER_PADDLE_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
ANALYZER_PADDLE_OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
ANALYZER_PADDLE_MODEL_SOURCE=bos
ANALYZER_MODEL_CACHE=/replace-with-persistent-volume/model-cache

# OpenAI-compatible content generation provider (DeepSeek, GLM, OpenAI, etc.).
CONTENT_MODEL_PROVIDER=deepseek
CONTENT_MODEL_BASE_URL=https://api.deepseek.com/v1
CONTENT_MODEL_NAME=replace-with-model-name
CONTENT_MODEL_API_KEY=replace-with-provider-key

# Independent project assistant. All four values are required; never reuse the
# content-generation or analyzer key as an implicit fallback.
PROJECT_ASSISTANT_MODEL_PROVIDER=openai-compatible-provider
PROJECT_ASSISTANT_MODEL_BASE_URL=https://replace-with-project-assistant-endpoint/v1
PROJECT_ASSISTANT_MODEL_NAME=replace-with-project-assistant-model
PROJECT_ASSISTANT_MODEL_API_KEY=replace-with-independent-project-assistant-key
