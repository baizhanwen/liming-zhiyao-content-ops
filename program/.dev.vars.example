# 本地登录。仅 localhost / 127.0.0.1 生效。
LOCAL_DEV_AUTH=1
LOCAL_DEV_USER_ID=local-owner
LOCAL_DEV_USER_EMAIL=local-owner@localhost
LOCAL_DEV_USER_NAME=本地管理员

# 本地和局域网运行必须保持为 0；仅可信反向代理环境才可设为 1。
TRUST_FORWARDED_IDENTITY=0

# 客户交付首次开通配置。普通本地使用保持默认，不需要填写。
DELIVERY_MODE=0
# GitHub 下载版由打包程序设为 0，首次只需创建管理员；旧商业交付保持为 1。
FIRST_RUN_REQUIRE_SETUP_CODE=1
FIRST_RUN_SETUP_CODE=
FIRST_RUN_SETUP_CODE_HASH=

# 网页与本地视频分析服务之间的通信配置。
ANALYZER_SERVICE_TOKEN=local-change-me-before-using-analyzer
ANALYZER_BASE_URL=http://127.0.0.1:3000
ANALYZER_WORKER_ID=analyzer-01

# 本项目首次启动自动生成独立密钥；留空即可，已有值不会被启动过程覆盖。
MODEL_SETTINGS_ENCRYPTION_KEY=
LOCAL_RUNTIME_TOKEN=
LOCAL_RUNTIME_URL=http://127.0.0.1:3001

# 留空时自动使用安装程序记录的 FFmpeg/ffprobe，避免继承 Windows 中同名的错误环境变量。
ANALYZER_FFMPEG=
ANALYZER_FFPROBE=

# 模型默认值；启动后可在网页“系统设置”中保存各公司的模型和密钥。
ANALYZER_LLM_PROVIDER=minimax
ANALYZER_LLM_BASE_URL=https://api.minimax.cn/v1
ANALYZER_LLM_MODEL=MiniMax-M3.1-Flash
ANALYZER_LLM_API_KEY=

# Windows x64 中文默认用 Qwen3-ASR-1.7B 转写，以下兼容设置选择 Whisper 时间定位模型。
ANALYZER_ASR_ENGINE=faster-whisper
ANALYZER_ASR_MODEL=large-v3-turbo
ANALYZER_ASR_LANGUAGE=zh
ANALYZER_ASR_DEVICE=auto

# 内容生成默认复用 ANALYZER_LLM_*。只有需要使用另一套模型时才填写。
CONTENT_MODEL_PROVIDER=
CONTENT_MODEL_BASE_URL=
CONTENT_MODEL_NAME=
CONTENT_MODEL_API_KEY=

# MiniMax-M3.1-Flash 使用普通图片输入接口；旧 Token Plan/MCP 仍可在网页单独配置。
ANALYZER_VISION_PROVIDER=minimax
ANALYZER_VISION_BASE_URL=https://api.minimax.cn/v1
ANALYZER_VISION_MODEL=MiniMax-M3.1-Flash
ANALYZER_VISION_API_KEY=

# 独立项目助理，可选；启用时四项必须同时填写。
PROJECT_ASSISTANT_MODEL_PROVIDER=
PROJECT_ASSISTANT_MODEL_BASE_URL=
PROJECT_ASSISTANT_MODEL_NAME=
PROJECT_ASSISTANT_MODEL_API_KEY=

# 抖音链接通过 Skill Collect 独立匿名 Chromium 采集，不使用 Cookie 配置。
# 在网页“系统设置 → 视频分析服务”一键配置依赖、模型和浏览器。

# 分阶段硬时限（秒）；旧配置不必新增这些键，留空使用内置默认值。
# 语音与画面并行阶段共用 EVIDENCE 时限。长视频另加有限时长预算。
ANALYZER_TIMEOUT_INITIALIZATION_SECONDS=1800
ANALYZER_TIMEOUT_DOWNLOAD_SECONDS=900
ANALYZER_TIMEOUT_MEDIA_SECONDS=900
ANALYZER_TIMEOUT_EVIDENCE_SECONDS=1800
ANALYZER_TIMEOUT_ARTIFACTS_SECONDS=600
ANALYZER_TIMEOUT_MODEL_SECONDS=1800
ANALYZER_TIMEOUT_TASK_SECONDS=7200
