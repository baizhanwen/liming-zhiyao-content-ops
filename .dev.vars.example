# Local browser identity. It is accepted only on localhost/127.0.0.1 and the
# Vite server is bound to 127.0.0.1, so it is not a public login mechanism.
LOCAL_DEV_AUTH=1
DELIVERY_MODE=0
FIRST_RUN_SETUP_CODE=
FIRST_RUN_SETUP_CODE_HASH=
LOCAL_DEV_USER_ID=local-owner
LOCAL_DEV_USER_EMAIL=local-owner@localhost
LOCAL_DEV_USER_NAME=本地管理员
# Accept platform-provided identity headers only behind a trusted proxy that
# strips client-supplied copies. Keep disabled for local and LAN operation.
TRUST_FORWARDED_IDENTITY=0

# P0 safety switch. Unset/0 keeps generation available for ordinary members in
# development and test. Set to 1 explicitly in production to freeze generation.
GENERATION_P0_FREEZE=0
BUILD_ID=codex-gate6-20260820
DATABASE_MIGRATION_VERSION=0028_project_assistant_memory_chat
ANALYSIS_CONTRACT_VERSION=analysis.v7

# The Python analyzer must use the same token. Change this before enabling the
# analyzer on a shared machine.
ANALYZER_SERVICE_TOKEN=local-change-me-before-using-analyzer
ANALYZER_BASE_URL=http://127.0.0.1:3000
ANALYZER_WORKER_ID=analyzer-01
# Browser fallback. Chromium browsers on Windows may block direct decryption.
# Optional profile syntax: edge:Default. Firefox is the reliable direct option.
ANALYZER_YTDLP_COOKIES_FROM_BROWSER=edge
# Preferred on Windows: import a Douyin-only Netscape file with the refresh script.
ANALYZER_YTDLP_COOKIE_FILE=.local/douyin-cookies.txt

# OpenAI-compatible analysis provider. Content generation reuses these values
# unless the optional CONTENT_MODEL_* overrides below are filled in.
CONTENT_MODEL_PROVIDER=deepseek
CONTENT_MODEL_BASE_URL=https://api.deepseek.com/v1
CONTENT_MODEL_NAME=
# Optional allowlists. Leave empty to preserve the current configured provider/model.
CONTENT_MODEL_ALLOWED_PROVIDERS=
CONTENT_MODEL_ALLOWED_MODELS=
CONTENT_MODEL_API_KEY=
ANALYZER_LLM_PROVIDER=deepseek
ANALYZER_LLM_BASE_URL=https://api.deepseek.com/v1
ANALYZER_LLM_MODEL=
ANALYZER_LLM_API_KEY=

# MiniMax Token Plan visual understanding through the official MCP understand_image tool.
# The Key must come from Token Plan and begin with sk-cp; OCR stays separate.
ANALYZER_VISION_PROVIDER=minimax-token-plan
ANALYZER_VISION_BASE_URL=https://api.minimaxi.com
ANALYZER_VISION_MODEL=understand_image
ANALYZER_VISION_API_KEY=
ANALYZER_VISION_CONCURRENCY=2
# Independent project-assistant model for automatic project memory and
# inspiration conversations. Configure all four values. There is deliberately
# no fallback to CONTENT_MODEL_* or ANALYZER_LLM_*.
PROJECT_ASSISTANT_MODEL_PROVIDER=
PROJECT_ASSISTANT_MODEL_BASE_URL=
PROJECT_ASSISTANT_MODEL_NAME=
PROJECT_ASSISTANT_MODEL_API_KEY=

# Local media models. First use downloads model files into the English-only
# cache directory chosen automatically by the Python worker.
ANALYZER_MODEL_CACHE=
ANALYZER_ASR_MODEL=paraformer-zh
ANALYZER_ASR_DEVICE=cpu
ANALYZER_PADDLE_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
ANALYZER_PADDLE_OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
ANALYZER_PADDLE_MODEL_SOURCE=bos
